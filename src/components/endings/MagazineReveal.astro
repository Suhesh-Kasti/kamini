---
import HandwrittenNote from "../ui/HandwrittenNote.astro";
import HeroPhoto from "../ui/HeroPhoto.astro";
---

<div class="ending__inner ending--shopping" data-ending-scene>
  <div class="ending__layer">
    <div class="mag-panel mag-panel--left" data-mag-left></div>
    <div class="mag-panel mag-panel--right" data-mag-right></div>
    <div class="mag-cover" data-mag-cover>
      <span class="mag-kicker">the evidence issue</span>
      <span class="mag-title">both of them</span>
      <span class="mag-rule"></span>
      <span class="mag-note">printed without permission</span>
    </div>
    <div class="gold-gleam" data-gleam></div>
  </div>

  <HeroPhoto pair />

  <div class="ending__note" data-note-wrap>
    <HandwrittenNote />
  </div>

  <div class="ending__layer">
    <div class="mag-caption" data-mag-caption>not for sale</div>
    <div class="mag-barcode" aria-hidden="true"></div>
    <div class="mag-footer">the evidence issue / page one</div>
  </div>
</div>
