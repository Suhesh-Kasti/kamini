---
import HandwrittenNote from "../ui/HandwrittenNote.astro";
import HeroPhoto from "../ui/HeroPhoto.astro";
---

<div class="ending__inner ending--crochet" data-ending-scene>
  <div class="ending__layer">
    <div class="ending-glow" data-glow></div>
    <div class="weave-border"></div>
    <svg class="weave-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" data-weave>
      <path class="weave-path" d="M4,22 C22,10 30,36 44,26 C58,16 62,40 76,28 C86,20 92,26 96,20" data-thread="1" />
      <path class="weave-path" d="M6,48 C24,38 34,58 48,48 C62,38 70,60 84,48 C90,43 94,46 96,44" data-thread="2" />
      <path class="weave-path" d="M5,74 C22,64 32,86 46,74 C60,62 70,84 82,72 C88,67 93,70 96,68" data-thread="3" />
    </svg>
  </div>

  <HeroPhoto pair />

  <div class="ending__note" data-note-wrap>
    <HandwrittenNote />
  </div>

  <div class="ending__layer">
    <div class="yarn-ball" data-yarn aria-hidden="true"></div>
    <div class="yarn-thread" data-yarn-thread aria-hidden="true"></div>
    <div class="hook" data-hook aria-hidden="true"></div>
    <div class="granny" data-granny aria-hidden="true"></div>
    <div class="granny granny--two" data-granny aria-hidden="true"></div>

    <div class="pet pet--cat crochet-cat" data-cat>
      <div class="pet__tail"></div>
      <div class="pet__body"></div>
      <div class="pet__belly"></div>
      <div class="pet__paw pet__paw--l"></div>
      <div class="pet__paw pet__paw--r"></div>
      <div class="pet__head" data-head>
        <div class="pet__ear pet__ear--l"></div>
        <div class="pet__ear pet__ear--r"></div>
        <div class="pet__eye pet__eye--l" data-eye></div>
        <div class="pet__eye pet__eye--r" data-eye></div>
        <div class="pet__blush pet__blush--l"></div>
        <div class="pet__blush pet__blush--r"></div>
        <div class="pet__muzzle"></div>
        <div class="pet__nose"></div>
      </div>
    </div>

    <div class="blanket" data-blanket aria-hidden="true"></div>
    <div class="stitch-finish" data-stitch-finish>last stitch, promise</div>
  </div>
</div>
