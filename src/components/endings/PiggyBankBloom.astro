---
import HandwrittenNote from "../ui/HandwrittenNote.astro";
import HeroPhoto from "../ui/HeroPhoto.astro";
---

<div class="ending__inner ending--saving" data-ending-scene>
  <div class="ending__layer">
    <div class="ending-glow" data-glow></div>
    <div class="ledger-sheet"></div>
    <div class="coin-drop" data-drop-coin></div>
    <div class="coin-spark" data-coin-spark></div>
  </div>

  <HeroPhoto pair />

  <div class="ending__note" data-note-wrap>
    <HandwrittenNote />
  </div>

  <div class="ending__layer">
    <div class="flower flower--sprout" data-flower>
      <div class="flower__petal"></div><div class="flower__petal"></div><div class="flower__petal"></div>
      <div class="flower__petal"></div><div class="flower__petal"></div><div class="flower__petal"></div>
      <div class="flower__center"></div><div class="flower__stem"></div>
    </div>
    <div class="pet pet--pig piggy" data-pig>
      <div class="pet__body"></div>
      <div class="pet__belly"></div>
      <div class="pet__paw pet__paw--l"></div>
      <div class="pet__paw pet__paw--r"></div>
      <div class="pet__head" data-head>
        <div class="pet__ear pet__ear--l"></div>
        <div class="pet__ear pet__ear--r"></div>
        <div class="pet__eye pet__eye--l" data-eye></div>
        <div class="pet__eye pet__eye--r" data-eye></div>
        <div class="pet__blush pet__blush--l"></div>
        <div class="pet__blush pet__blush--r"></div>
        <div class="pet__muzzle"></div>
        <div class="pet__nose"></div>
      </div>
    </div>
    <div class="counter-tick" data-counter-tick>+1 little future</div>
  </div>
</div>
