---
import HandLetter from "./HandLetter.astro";

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

const themes = [
  "angry_kitten",
  "sad_cloud",
  "sweet_ask",
  "shopping_muse",
  "save_the_coins",
  "cozy_crochet",
  "just_for_fun",
];
---

<div class:list={["note-paper", className]} data-note-paper>
  <div class="note-letter-wrap">
    {themes.map((theme) => (
      <HandLetter theme={theme} class={`note-letter note-letter--${theme}`} />
    ))}
  </div>
  <p class="note-text" data-note-text></p>
  <p class="note-sign" data-note-sign></p>
</div>
