---
import HandLetter from "./HandLetter.astro";
---

<svg class="svg-defs" aria-hidden="true" focusable="false">
  <defs>
    <filter id="rough-edge">
      <feTurbulence type="fractalNoise" baseFrequency="0.012 0.02" numOctaves="3" seed="8" result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="4" xChannelSelector="R" yChannelSelector="G" />
    </filter>
    <filter id="rough-strong">
      <feTurbulence type="fractalNoise" baseFrequency="0.025 0.035" numOctaves="3" seed="4" result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="7" xChannelSelector="R" yChannelSelector="G" />
    </filter>
    <filter id="paper-grain">
      <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" stitchTiles="stitch" />
      <feColorMatrix type="saturate" values="0" />
      <feComponentTransfer>
        <feFuncA type="linear" slope="0.3" />
      </feComponentTransfer>
    </filter>
  </defs>
</svg>

<div class="chrome" aria-hidden="true">
  <div class="chrome__grain"></div>

  <div class="chrome__world" data-world="angry_kitten">
    <div class="kraft-torn kraft-torn--top"></div>
    <div class="kraft-torn kraft-torn--bottom"></div>
    <div class="coffee-ring"></div>
    <svg class="doodle doodle--angry-cloud" viewBox="0 0 120 80">
      <path d="M18 52c-8-1-12-9-7-16 3-5 9-6 13-4 2-9 12-13 20-8 5-7 16-4 17 4 8-1 14 6 12 13-1 7-8 11-15 9-4 8-16 9-21 3-6 5-15 4-19-1Z" />
      <path d="M55 60l-7 12h9l-5 11" />
      <path d="M32 64l-4 9h6" />
    </svg>
    <svg class="doodle doodle--claw-corner" viewBox="0 0 120 120">
      <path d="M8 16c22 6 38 20 48 40" />
      <path d="M18 8c20 8 35 22 44 43" />
      <path d="M30 4c17 9 30 24 37 44" />
    </svg>
    <div class="tape tape--angry"></div>
    <div class="scribble scribble--angry"></div>
  </div>

  <div class="chrome__world" data-world="sad_cloud">
    <div class="watercolor watercolor--a"></div>
    <div class="watercolor watercolor--b"></div>
    <div class="watercolor watercolor--c"></div>
    <svg class="doodle doodle--umbrella" viewBox="0 0 120 100">
      <path d="M10 48c2-20 20-34 40-34 22 0 40 14 42 34-10-8-20-8-30 0-8-8-18-8-28 0-8-8-16-8-24 0Z" />
      <path d="M50 48v30c0 8 10 10 14 3" />
    </svg>
    <svg class="doodle doodle--tissue" viewBox="0 0 100 80">
      <path d="M18 34h64v38H18Z" />
      <path d="M30 34c0-12 10-18 20-18s20 6 20 18" />
      <path d="M34 44c6-6 12-6 16 0 4-6 10-6 16 0" />
    </svg>
    <svg class="doodle doodle--rain-scribble" viewBox="0 0 120 120">
      <path d="M20 4l-4 24" />
      <path d="M40 16l-4 28" />
      <path d="M62 2l-4 22" />
      <path d="M84 14l-4 26" />
      <path d="M104 6l-4 22" />
    </svg>
  </div>

  <div class="chrome__world" data-world="sweet_ask">
    <div class="choco-strip choco-strip--top"></div>
    <div class="choco-strip choco-strip--bottom"></div>
    <div class="gold-rule gold-rule--top"></div>
    <div class="gold-rule gold-rule--bottom"></div>
    <div class="foil-block foil-block--left"></div>
    <div class="foil-block foil-block--right"></div>
    <div class="cocoa-dust"></div>
    <svg class="doodle doodle--cocoa" viewBox="0 0 90 110">
      <path d="M24 24h42l-6 62c-9 8-21 8-30 0Z" />
      <path d="M24 24c2-10 40-10 42 0" />
      <path d="M36 44c8 5 16 5 22 0" />
    </svg>
  </div>

  <div class="chrome__world" data-world="shopping_muse">
    <div class="mag-rule mag-rule--a"></div>
    <div class="mag-rule mag-rule--b"></div>
    <div class="mag-issue">issue no. 02</div>
    <div class="film-strip"></div>
    <div class="price-tag price-tag--one">worth it</div>
    <div class="price-tag price-tag--two">for her</div>
    <div class="foil-sweep"></div>
    <svg class="doodle doodle--monogram" viewBox="0 0 100 100">
      <path d="M18 74c10-32 22-48 34-48 12 0 18 16 30 48" />
      <path d="M32 58h40" />
      <path d="M50 26v48" />
    </svg>
  </div>

  <div class="chrome__world" data-world="save_the_coins">
    <div class="wood-grain"></div>
    <div class="receipt-strip">
      <span>little future</span>
      <span>saving for soft things</span>
      <span>keep the coin</span>
    </div>
    <svg class="doodle doodle--chart" viewBox="0 0 140 100">
      <path d="M12 82h120" />
      <path d="M12 82V12" />
      <path d="M24 70l20-14 18 6 22-24 20 8 18-20" />
      <circle cx="104" cy="32" r="4" />
    </svg>
    <svg class="doodle doodle--pig-outline" viewBox="0 0 120 100">
      <path d="M22 54c0-18 17-30 38-30s38 12 38 30-17 28-38 28-38-10-38-28Z" />
      <path d="M64 34l8-10 8 10" />
      <path d="M46 54h4M72 54h4" />
      <path d="M58 64h8" />
      <path d="M96 50c8-4 12 2 10 8" />
    </svg>
    <div class="coin-doodle coin-doodle--one"></div>
    <div class="coin-doodle coin-doodle--two"></div>
    <div class="coin-doodle coin-doodle--three"></div>
  </div>

  <div class="chrome__world" data-world="cozy_crochet">
    <div class="stitch-border"></div>
    <div class="knit-overlay"></div>
    <svg class="yarn-hang" viewBox="0 0 240 200" preserveAspectRatio="none">
      <path d="M18 0c6 40-12 58 2 96 10 28-4 56 8 104" />
      <path d="M214 0c-8 34 10 58-4 92-10 26 4 62-6 108" />
    </svg>
    <div class="granny granny--tl"></div>
    <div class="granny granny--br"></div>
    <div class="granny granny--tr"></div>
    <svg class="doodle doodle--yarn-coil" viewBox="0 0 220 120">
      <path d="M30 84c-10-20 4-42 26-46 26-5 48 12 50 32 2 18-14 32-34 30-18-2-28-14-24-26 4-10 16-14 26-8" />
      <path d="M58 84c-14-2-20-14-14-24 5-8 16-8 22-2" />
      <path d="M126 84c30 0 54-16 64-40" />
    </svg>
    <svg class="doodle doodle--chain-stitch" viewBox="0 0 260 30" preserveAspectRatio="none">
      <path d="M4 15c10-12 18-12 28 0s18 12 28 0 18-12 28 0 18 12 28 0 18-12 28 0 18 12 28 0 18-12 28 0 18 12 28 0" />
    </svg>
  </div>

  <div class="chrome__world" data-world="just_for_fun">
    <div class="construction-grain"></div>
    <div class="tape tape--fun-one"></div>
    <div class="sticker-doodle sticker-doodle--star">kept</div>
    <svg class="doodle doodle--squiggle" viewBox="0 0 200 60">
      <path d="M6 38c16-24 30-24 46 0s30 24 46 0 30-24 46 0 30 24 46 0" />
    </svg>
  </div>

  <div class="chrome__claws" data-claw-layer></div>
  <div class="chrome__rain" data-rain-layer></div>
  <div class="chrome__counter" data-coin-counter>
    <span class="chrome__counter-label">little future</span>
    <span class="chrome__counter-value" data-coin-value>0</span>
  </div>
</div>

<button type="button" class="chrome__keepsake" data-sticker-keepsake hidden aria-label="peel the sticker away">
  <span>keep me</span>
</button>

<HandLetter theme="angry_kitten" />
<HandLetter theme="sad_cloud" />
<HandLetter theme="sweet_ask" />
<HandLetter theme="shopping_muse" />
<HandLetter theme="save_the_coins" />
<HandLetter theme="cozy_crochet" />
<HandLetter theme="just_for_fun" />
