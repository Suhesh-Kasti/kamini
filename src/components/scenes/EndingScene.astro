---
import KittenApology from "../endings/KittenApology.astro";
import CloudsPartBloom from "../endings/CloudsPartBloom.astro";
import ChocolateSnap from "../endings/ChocolateSnap.astro";
import MagazineReveal from "../endings/MagazineReveal.astro";
import PiggyBankBloom from "../endings/PiggyBankBloom.astro";
import YarnWeaveNote from "../endings/YarnWeaveNote.astro";
import StickerDrop from "../endings/StickerDrop.astro";

const endings = [
  { name: "kitten_apology", Component: KittenApology },
  { name: "clouds_part_bloom", Component: CloudsPartBloom },
  { name: "chocolate_snap", Component: ChocolateSnap },
  { name: "magazine_reveal", Component: MagazineReveal },
  { name: "piggy_bank_bloom", Component: PiggyBankBloom },
  { name: "yarn_weave_note", Component: YarnWeaveNote },
  { name: "sticker_drop", Component: StickerDrop },
];
---

<section id="ending-scene" class="ending" hidden aria-live="polite">
  <div id="ending-host" class="ending__host"></div>
  <div class="ending__actions" data-ending-actions></div>

  {endings.map(({ name, Component }) => (
    <template data-ending={name}>
      <Component />
    </template>
  ))}
</section>
